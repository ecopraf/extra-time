# EXTRA TIME — variabili d'ambiente (esempio)
# Copia in .env.local (non committare valori reali).

# Database del Football Data Core (Neon).
# IMPORTANTE: in locale usa il BRANCH DI SVILUPPO, non la produzione.
#   - Produzione (Vercel): branch principale del progetto Neon.
#   - Sviluppo locale (.env.local): branch "dev" isolato, così i test non
#     toccano i dati reali. Crealo con:  pnpm db:dev-branch
#     (prerequisiti: npm i -g neonctl && neon auth — vedi .kiro/steering/neon.md)
DATABASE_URL=postgres://neondb_owner:***@ep-xxx-dev.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Hub Impostazioni — autenticazione
# L'accesso avviene con utente/password (tabella users, hashing scrypt).
# Il primo amministratore si crea con:
#   ADMIN_EMAIL=tuo@email.it node --env-file=.env.local scripts/create-admin.mjs
# (la password viene generata e mostrata una sola volta, oppure passala con ADMIN_PASSWORD)
